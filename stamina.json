{"kind":"Article","sha256":"4e3ad23879e6347406d5fe5426ed942701b47ebb013cee546a25bf688d1096a1","slug":"stamina","location":"/combat/stamina.md","dependencies":[],"frontmatter":{"title":"Stamina","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"exports":[{"format":"md","filename":"stamina.md","url":"/build/stamina-5a18d6acae9dcbe286ef61d27a2c0ac4.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"At the core of the SWN combat system is stamina. Stamina is a renewable resource that all characters have. Nearly all of the time, characters have 6 stamina per round, resetting at the start of the player’s turn.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"qIplsTnd3K"}],"key":"GpQ6Uqr59J"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"HsRsg2AVlY"}],"key":"RtJqD5dkSk"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"While the 6-stamina-per-turn maxim will serve for much of the game, some capstone abilities provide characters with additional stamina, and others provide temporary recovery of stamina during a round.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GTKoWD5bMn"}],"key":"AHaz6vquJN"}],"key":"gV7gNMbkAP"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Stamina fuels nearly everything you do in combat, defining how you choose to allocate the limited time and energy in the few seconds that constitute a round.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ovpD2sjJII"}],"key":"BvrvkzozR4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Attacks (both martial and arcane) require stamina to carry out","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Na3EOJUHHo"}],"key":"jrP1TBrLrt"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Defense, including parrying and dodging, require stamina","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"jI4UtHKOKH"}],"key":"VC8hJfmEjK"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Reactions, which are taken at will during combat, require stamina","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"OtqLQ5504B"}],"key":"ACPw4Xkfuu"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Some abilities specifically denote a stamina cost","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"lfPzo2kTnN"}],"key":"YdtxDEGX0B"}],"key":"KLz7Oui7PD"}],"key":"ShXbb3h0F4"}],"key":"YUX0c1ExCn"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Combat","url":"/combat","group":"Reasoning Origins"},"next":{"title":"Initiative","url":"/initiative","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}