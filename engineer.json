{"kind":"Article","sha256":"13dcaf968a3e5c56b32548763c07e8aae69e499193f927dd7a03b65dcc9124d7","slug":"engineer","location":"/origins/reasoning/engineer.md","dependencies":[],"frontmatter":{"title":"Engineer","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"thumbnail":"/build/engineer-95cbf448fb2ee4d578b82fdf37e5691d.png","exports":[{"format":"md","filename":"engineer.md","url":"/build/engineer-3a0cf541c6b247c033ecb563244b474f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/engineer-95cbf448fb2ee4d578b82fdf37e5691d.png","alt":"engineer","align":"center","key":"ojQpVJtHx5","urlSource":"../../img/origins/engineer.png"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Engineers possess both theoretical knowledge and hands-on skills to turn ideas into functioning devices. Whether self-taught or formally trained, they have an intuitive grasp of how components interact and can envision solutions that others might miss.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Pt8daEALh1"}],"key":"lRGzXMPEXL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":12,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Technical Insight: When examining a mechanical device, trap, or structure, you can make a Reasoning check to understand its purpose, operation, and potential weaknesses. On a success, you gain advantage on any subsequent checks to interact with, disable, or repair it.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"noSXURRxTQ"}],"key":"IOJ4fTOCCU"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Blueprint Mind: Once per day, when facing a mechanical problem (a locked mechanism, a broken bridge, etc.), you can spend 10 minutes analyzing it to gain a strong insight into a workable solution, and major advantage on any checks to overcome or fix the issue.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"CLLqnRc0CY"}],"key":"Yuds8Vhb6h"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Improvised Tools: You can fashion basic tools from available materials with a successful DL 15 Reasoning/Tinkering check. While not as effective as proper tools, these improvised implements allow you to attempt normally tool-dependent tasks without penalty.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"R6pgUPqvGL"}],"key":"XZhZWL1jRk"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Efficient Crafting: When crafting devices during downtime, you can make an additional check per downtime period (3 instead of the standard 2), representing your efficient workflow and technical expertise.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"TtSEiayFDc"}],"key":"xmkiR4x3rs"}],"key":"xFf1u6oL7w"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"When you choose this origin, select one of the following specializations that represents your particular approach to engineering:","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"FpfIL449js"}],"key":"HSJO6a8LLt"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Arcane Engineer","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ijE9FSre7Z"}],"identifier":"arcane-engineer","label":"Arcane Engineer","html_id":"arcane-engineer","implicit":true,"key":"xSXqPKeapk"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You blend mechanical principles with magical theory to create devices that harness arcane energies. You can identify the function of magical devices with a Reasoning/Tinkering check. When creating devices with magical components, you reduce the rarity requirement by one step or the crafting time by 25%.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"AD4hrSDWXK"}],"key":"XBQJeGWNm2"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Backstory Hooks","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"JJZ3IiKOh9"}],"key":"i4BvYxBLcm"}],"key":"wDlpIkbugE"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":25,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Did you learn arcane engineering from formal study or experimentation?","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"zU5AcD8JcW"}],"key":"aktTW7D6tA"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Have you ever created something that had unexpected magical side effects?","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"V72MchrFEL"}],"key":"afU4RqHTdr"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"How do traditional mages view your mechanical approach to magic?","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"MqMUczn9IV"}],"key":"RlvugKYcz2"}],"key":"UFhn0HhZou"}],"key":"hgIDDIoQx7"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Intuitive Tinkerer","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"VrJGSSlAh2"}],"identifier":"intuitive-tinkerer","label":"Intuitive Tinkerer","html_id":"intuitive-tinkerer","implicit":true,"key":"xeBkAz4lxM"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"You have no formal training but possess a natural genius for improvisation and making do with whatever materials are at hand. You can substitute common materials for rare components in crafting recipes with a successful Reasoning check (DL based on the rarity gap). You can create temporary, one-use versions of gadgets in just 1 hour during a rest period. Once per day, when encountering a broken device, you have advantage on checks to jury-rig a temporary fix that will last for 1d4 hours.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"PU8EEFtnIL"}],"key":"v6WKlKAbr8"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Backstory Hooks","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"ynzvPC8ACY"}],"key":"nAY6dVGehE"}],"key":"WPxosapX2g"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":35,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"What was the first complex thing you built without instructions?","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"JqZOm3TqcO"}],"key":"jNIQAFE1Gt"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Has your improvised approach ever backfired spectacularly?","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"tWj9g0MkMc"}],"key":"Jo6FGnXbpq"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Do you feel insecure around formally trained engineers, or proud of your self-taught abilities?","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"tte34m1ggh"}],"key":"yPW3O4qmcR"}],"key":"nBBZ0UpNhx"}],"key":"E92kj0xO8d"},{"type":"heading","depth":2,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Specialist Engineer","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"RyWar5FyQv"}],"identifier":"specialist-engineer","label":"Specialist Engineer","html_id":"specialist-engineer","implicit":true,"key":"V0krP37w21"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"You have deep expertise in a specific field of engineering, allowing you to create more sophisticated devices within your specialty. Choose a specialty: siege weapons, locks and traps, transportation, communication, or aquatic systems. You have advantage on all checks related to your specialty. Devices within your specialty can have one additional feature without increasing the crafting difficulty. During downtime, you can study a complex device within your specialty to gain insight that will give you advantage on creating a similar device in the future.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"YgCEpns1iR"}],"key":"I4FyR67kM1"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Backstory Hooks","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"n4Of0M0jEU"}],"key":"b5qepgbcBQ"}],"key":"woG5op0ijC"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":45,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"What drew you to your particular specialty?","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ttNZTTghlJ"}],"key":"bwayoJUeSv"},{"type":"listItem","spread":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Have you created anything considered revolutionary in your field?","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"nMIlTehR7N"}],"key":"JEvICSzuPu"},{"type":"listItem","spread":true,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Do you collaborate with other specialists, or prefer to work independently?","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ZIaPRAqMYE"}],"key":"ovBfNGYgPf"}],"key":"Auq5DgBCqD"}],"key":"q4cLM85PmB"},{"type":"heading","depth":3,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Biomechanical Engineer","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"PX6KTTNs7U"}],"identifier":"biomechanical-engineer","label":"Biomechanical Engineer","html_id":"biomechanical-engineer","implicit":true,"key":"OwKeDfsm2u"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"You focus on the intersection of mechanical principles and biological systems, creating prosthetics, medical devices, or tools that interact with living beings. You can create devices that enhance natural biological functions or compensate for disabilities. When creating devices meant to be worn or implanted, you reduce the difficulty check by 2. You have advantage on Medicine checks that involve using mechanical tools or devices.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Fc393UVbxQ"}],"key":"iS6xjtxcvB"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Backstory Hooks","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"STwIY7wEvP"}],"key":"cGsSPBZKyY"}],"key":"Hjg6stXAGK"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"What inspired you to work at the intersection of medicine and engineering?","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"E2bADHJhJY"}],"key":"EAtLF9yGxD"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Have you ever created a prosthetic or enhancement for yourself?","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"oYZYeXAv5A"}],"key":"QNZP7PDEQO"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"How do healers and medical practitioners view your work?","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"dyZl1K2vEC"}],"key":"aQ1vvf82vR"}],"key":"ncZgExQDBm"}],"key":"JW1VsQgSwt"}],"key":"eLhbvKekWV"}],"key":"nMnFN5dpK0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Augur","url":"/augur","group":"Reasoning Origins"},"next":{"title":"Scholist","url":"/scholist","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}