{"kind":"Article","sha256":"4ce2c6caffd321363751070aab28b47280ca29c2bc10d693fcd9d520f1349d7f","slug":"tradesmith","location":"/origins/physicality/tradesmith.md","dependencies":[],"frontmatter":{"title":"Tradesmith","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"thumbnail":"/build/tradesmith-2-8aa1ba12987c5fd241ac89de74425818.png","exports":[{"format":"md","filename":"tradesmith.md","url":"/build/tradesmith-e7395ff3868c31c54f07872dacf072a3.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/tradesmith-2-8aa1ba12987c5fd241ac89de74425818.png","alt":"augur","width":"400px","align":"center","key":"auyPFNCmi6","urlSource":"../../img/origins/tradesmith-2.png"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"You earned your living through physical work - mining, construction, smithing, or other demanding trades that built your body and endurance through daily toil.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"HUx8csZFWr"}],"key":"Lc40ScDmqS"},{"type":"details","open":true,"children":[{"type":"summary","children":[{"type":"text","value":"Practiced Endurance","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"qFUAvZ3ReH"}],"key":"IXnsLB7TZn"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"You can work twice as long as others before suffering fatigue. During downtime activities requiring physical labor, you complete them in half the normal time.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"L66qEhMEon"}],"key":"xuF6An4OJ7"}],"key":"oL6UHOodbc"},{"type":"details","open":true,"children":[{"type":"summary","children":[{"type":"text","value":"Tradecraft","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"KLfY