ldren":[{"type":"text","value":"+5","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"VVdv6sz3ou"}],"key":"o9gXE9a85B"},{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"All spells cost +2 Stamina and deal 2d12 damage to the caster,","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"tzfkg2eyhV"}],"key":"AHQElt8pT7"}],"key":"u5TkmlF57N"},{"type":"tableRow","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"+7","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"lxb3IhqsEx"}],"key":"Xblws0KTDf"},{"type":"tableCell","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Imparts Exhaustion, +2 Stamina, 2d12 damage, and d20 roll, if higher than player level, immediate drop to 0 hp","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"cnG0ONwLPV"}],"key":"qVlmifrv5Y"}],"key":"aq5gJPHuAs"},{"type":"tableRow","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"+9","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"bjHOwHOhRU"}],"key":"hnA0Kob2su"},{"type":"tableCell","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"+2 stamina, immediate incapacitation","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"M6elmQAKhI"}],"key":"CJmXFM9ULK"}],"key":"SeWq9kcFML"}],"key":"hSJ3G12VnT"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"bNV7Mq9V2A"}],"key":"AcnDaCxOl5"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"At low levels, most spells have a TOX of 1-3. This means that as a 3rd level player (TV 10), you can cast 3-10 spells before suffering adverse effects, depending on which you cast. As always, you can push past these limits, but at your own peril!","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"q337jX5tX5"}],"key":"jCdaEbPGqe"}],"key":"zEMnS7sQoQ"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Equipment TOX","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"h6bST5B6sy"}],"identifier":"equipment-tox","label":"Equipment TOX","html_id":"equipment-tox","implicit":true,"key":"jxd24UmKNM"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Martial characters are not left out entirely from thinking about arcane toxicitiy. Magical weapons, even martial ones, tend to carry a low, but non-zero TOX cost. This means that a `use’ of the weapon or item increases the TOX of the bearer, and usage beyond their ATV invokes the typical effects, unless stated otherwise on the item. Martial users can, of course, switch to conventional weapons when nearing their ATV, or choose to take additional risk to continue gaining the benefits the arcane weapon provides.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"iHJUdBGRUT"}],"key":"BqXTQ2btm8"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Healing Tox","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"CW38Iku2dT"}],"identifier":"healing-tox","label":"Healing Tox","html_id":"healing-tox","implicit":true,"key":"hp8KmWXQKi"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Another critical consideration for toxicity is that being healed via magic increases the recipients’ arcane toxicity. Healing spells, Potions imbued with magic, etc., provide the most potent healing effects, but also push you toward your ATV. This might, at certain times, encourage mundane healing techniques which are less potent but do not have this associated cost.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"KUir5Vc8mz"}],"key":"Wem6N8GMMk"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"When you cast a healing spell on yourself, you do not take additional tox beyond the casting cost, representing your innate knowledge of your own body.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"A76FGzNBIz"}],"key":"znySmYJMyn"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Because toxicity only resets on a full rest, eventually, a party of adventurers will be forced to rest both so that spellcasters clear their tox to cast spells, and so that damage soaking tanks can clear their tox in order to be healable.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"gSDPCTWuFk"}],"key":"X3BabdE6vS"}],"key":"CRPiLsKWBB"}],"key":"jmyodumkts"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Learning Magic","url":"/learning-magic","group":"Reasoning Origins"},"next":{"title":"Spell List","url":"/spell-list","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}