}],"key":"oQqOZ9N2k6"},{"type":"tableCell","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"15","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"hMZD5vDflb"}],"key":"VXOV8R9SgF"}],"key":"uZNBQlq7hC"},{"type":"tableRow","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"5+","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ycEysZupgx"}],"key":"z1aXYg9KGq"},{"type":"tableCell","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"20","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"JsktQh4OtL"}],"key":"uR6TQTdkpC"}],"key":"bJQLLeTu2x"}],"key":"pzt8DVUoB6"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The cap at 20 TOX reflects the typical arcanic limit of a mortal body. Some special items, or capstone abilities, can unlock higher ATV.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"VGVoXHjDrj"}],"key":"McAJrK52cJ"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"When you choose to push above the ATV of your character to continue casting magic, you begin to take on the effects described by the following table:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"xPcHuzijMZ"}],"key":"WNZwpssyxS"},{"type":"table","position":{"start":{"line":25,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":25,"column":1},"end":{"line