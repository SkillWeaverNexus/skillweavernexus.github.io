{"kind":"Article","sha256":"42b2f3ce5c7af015965bf2f0d8738a9705c7a86f5e97649f5d52111bf255c64a","slug":"overview","location":"/overview.md","dependencies":[],"frontmatter":{"title":"Overview","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"exports":[{"format":"md","filename":"overview.md","url":"/build/overview-a242ea5ac84a87b33c19d668ecf97443.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"There are six skill trees to choose from in SWN, which cover the six primary ability areas. These core skills are","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"m9H00l4Tqt"}],"key":"F4okD8E1kT"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"crossReference","label":"Physicality","identifier":"term-physicality","kind":"definitionTerm","children":[{"type":"text","value":"Physicality","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"P7dnod7vDg"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-physicality","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"MJsmQ8H3XG"},{"type":"text","value":", which covers (in general) both strength and dexterity based abilities,","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kc3MsYu8qG"}],"key":"QW8Lic4VDk"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"crossReference","label":"Nature","identifier":"term-nature","kind":"definitionTerm","children":[{"type":"text","value":"Nature","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"A9IZXGKwiK"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-nature","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"Sx7TyqFQQx"},{"type":"text","value":", which covers health, including mundane and magical healing, poisons and decoctions, and alchemical development,","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Kc5xW3lHug"}],"key":"dHQM4kS9rn"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"crossReference","label":"Personality","identifier":"term-personality","kind":"definitionTerm","children":[{"type":"text","value":"Personality","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"rYuG5IfoPh"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-personality","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"kS4qbcXhTL"},{"type":"text","value":", which covers social abilities, including persuasion and deception,","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"iZl6lT4uPS"}],"key":"DvYn8f21hw"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"crossReference","label":"Perception","identifier":"term-perception","kind":"definitionTerm","children":[{"type":"text","value":"Perception","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"vr5O911qR6"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-perception","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"SzMsEshKn0"},{"type":"text","value":", which covers degrees of noticing and detecting with the various senses,","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"AWihZckebU"}],"key":"cxDTqDyz5X"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"crossReference","label":"Reasoning","identifier":"term-reasoning","kind":"definitionTerm","children":[{"type":"text","value":"Reasoning","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"YzLYa7r9wH"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-reasoning","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"mVn2mdVvl6"},{"type":"text","value":", which covers logic and insight and the use of magic, and","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"qh3mmGRAwf"}],"key":"dBrIx26HXk"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"crossReference","label":"Stealth","identifier":"term-stealth","kind":"definitionTerm","children":[{"type":"text","value":"Stealth","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"rKV9hRcn5S"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-stealth","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"AsetjsFlQ0"},{"type":"text","value":", which covers all aspects of avoiding detection.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"nhIGRMlrBC"}],"key":"vMjYihJSJL"}],"key":"sBK3oRiAfo"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"These core skills have some subdivisions that are triggered circumstantially --- for example, Stealth checks make a distinction between which sense is primarily being obscured, whether sight, sound, smell, or touch. The subdivisions for each skill, and when those checks are relevant, are detailed in the Skills chapter. Finally, the special tree contains more unique and involved abilities, which do not fit in the other categories.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"t4x7qVtwNr"}],"key":"RgTWOY8OHF"},{"type":"heading","depth":2,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Ability Dice","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"PCVOMj2CTR"}],"identifier":"ability-dice","label":"Ability Dice","html_id":"ability-dice","implicit":true,"key":"RCyHRefL4u"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"In SWN, you have a die, one of (d4, d6, d8, d10, or d12) associated with each core skill. A d4 in a skill means it is “untrained,” which means you cannot learn abilities in the trees for that core skill. At the start of the game, you will have a d4 in 4/6 of your core skills. For two skills of your choice, you can allocate a d6 and a d8, representing some prior progression or competence in those abilities.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"OHFZs7F303"}],"key":"XWS0F1Acvj"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Every time your player levels up (every time you accumulate 10 skill points), you select one of your core dice, and upgrade it to the next die up, up to d12.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"qHcp4iSx4H"}],"key":"dEcKp0a8qX"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Skill Tree Abilities","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"RJIirQQafG"}],"identifier":"skill-tree-abilities","label":"Skill Tree Abilities","html_id":"skill-tree-abilities","implicit":true,"key":"rwfB2a5uKN"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Abilities provide key, unique skills within the game, ranging from bonuses to standard ability rolls under specific (or general) circumstances, to tree-defining abilities. To learn abilities in a certain skill tree (other than special), you must be ``trained’’ in that skill, which means you do not have a d4 die for that skill.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"JZ7I8Wpcuw"}],"key":"kRlEpXvHzL"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Every ability in SWN has several key characteristics:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"gsIyu3C7V0"}],"key":"cKPVj6qObm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":26,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The Tier, which is a form of “ability level”. Tiers do not match 1:1 with player level, but define how much investment is needed in a particular tree to take abilities in that tier,","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"dunIRRUEWr"}],"key":"gpNVClsxBG"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The Cost, which is the number of skill points required to obtain the ability,","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"JwEPuHDgDO"}],"key":"Vj99IWUJUB"},{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Prerequisites, which define any other abilities one must obtain before acquiring a given ability. Prerequisites are not always in the same tree, and","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"xCreXEdmWv"}],"key":"j3EKayVrIp"},{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Minimum Player Level, which for some abilities enforces the player be a certain level before an ability can be taken.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"wR6FaZsVQh"}],"key":"XndaJ1ID1B"}],"key":"u6VaQGtfo0"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Every Tier in a given skill tree defines a ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"bydSChILRb"},{"type":"crossReference","label":"Minimum Allocation","identifier":"term-minimum allocation","kind":"definitionTerm","children":[{"type":"text","value":"Minimum Allocation","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AykoK9NBuD"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-minimum-allocation","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"QSccDcd5Dr"},{"type":"text","value":". This is the number of skill points that must be invested in the level below a given tier before being able to invest in a given tier. This number is equal to the tier’s level. For example, to invest in a Tier 2 ability in Stealth, you must have invested 2 points into Tier 1 in Stealth. To invest in a Tier 3 ability in Stealth, you would need to have invested 3 points in Tier 2 of stealth, an so on.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"GxJpfb20il"}],"key":"tr52GtD1HU"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"This system represents the fact that more powerful abilities in a given discipline require more investment in that discipline to achieve, and creates a key character choice: invest heavily in fewer trees, becoming an expert, or invest broadly in all trees, becoming a generalist. There are advantages to both approaches, suiting different play styles and character backgrounds.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"tVTqvp9cEO"}],"key":"d60qnMFdvi"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Player Level","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"cngzsK0es2"}],"identifier":"player-level","label":"Player Level","html_id":"player-level","implicit":true,"key":"CTMoOV2nYm"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"You level up in SWN every time you receive 10 consecutive skill points. You do not have to “save” them; new skills can be acquired at every ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"vl7wKZozre"},{"type":"crossReference","label":"Downtime","identifier":"term-downtime","kind":"definitionTerm","children":[{"type":"text","value":"Downtime","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"Dk0pCJd6h5"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-downtime","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"BMPAUnsIwr"},{"type":"text","value":", in theory. Just keep a counter of skill points awarded, and whenever it hits 10, increment your player level and start over.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"RZDOltYxth"}],"key":"qpA8uQ5iHz"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Player level is significantly less important in SWN than other systems. Primarily, it is used by certain skills to prevent them from being taken by inexperienced characters. Typical things that accompany leveling up (e.g., more health, etc.) are obtained in the skill tree or at the player’s discretion.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"UH00p8YaAp"}],"key":"aAHZPdIT4w"}],"key":"JhE1pFmNJv"}],"key":"DKo2uojqUx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"SkillWeaver Nexus","url":"/","group":"SkillWeaver Nexus"},"next":{"title":"Character Origins","url":"/origins","group":"SkillWeaver Nexus"}}},"domain":"http://localhost:3000"}