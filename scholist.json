{"kind":"Article","sha256":"7040cef0a7d0bd7e99d145cc38e4ad46f9baad9b448839a04a7cb00704d757e6","slug":"scholist","location":"/origins/reasoning/scholist.md","dependencies":[],"frontmatter":{"title":"Scholist","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"thumbnail":"/build/scholist-6cb8ce68cad020740edadb04f2e477ef.png","thumbnailOptimized":"/build/scholist-6cb8ce68cad020740edadb04f2e477ef.webp","exports":[{"format":"md","filename":"scholist.md","url":"/build/scholist-9e1325bc4966431df07d85933e950de1.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/scholist-6cb8ce68cad020740edadb04f2e477ef.png","alt":"scholist","align":"center","key":"Ug6XQxUxkV","urlSource":"../../img/origins/scholist.png","urlOptimized":"/build/scholist-6cb8ce68cad020740edadb04f2e477ef.webp"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"You have earned a reputation as a scholar of note, and your Arcanic Die, if you cast spells, is Arcana. You hold a coveted\nScholars Token, which provides access to all but the most exclusive or restrictive libraries. Your skill at researching provides automatic success in finding tomes of particular title author or topic in any well organized repository (e.g., libraries, but not teetering piles of books in an arcane study). You have a major advantage on Investigation checks for finding references or discussion of particulars in any given written work.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"xtjmhAky2G"}],"key":"DFNJatCrgh"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Finally, you choose a specialty: history, cultural practices, arcana, religion, alchemy, or another from options provided by your GM. You have minor advantage when researching or recalling your specialty topic.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"OSXmRTsfFL"}],"key":"RObT1Hltc2"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Backstory Hooks","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"g42C4EpJX6"}],"key":"UAskUkKDuw"}],"key":"vWf8Yc52bj"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Most scholars earn their token with the publishing of a major thesis. What was yours about? It could be arcane or mundane.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Ib26SeYUNW"}],"key":"OvmR9PMkjX"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Most scholists studied in a university of some kind --- did you? Or how did you learn what you needed?","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"WQzoOLk24k"}],"key":"tRzsLf17bw"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Perhaps you got expelled or kicked out of school, and nabbed a scholar’s token on the way out. Might this catch up to you?","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"XM8D3aTD3y"}],"key":"asvnK1lJJq"}],"key":"arOmGgbGmW"}],"key":"GPlHW8YsSS"}],"key":"yG1ly2QCvl"}],"key":"cKLmCbhEs3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Engineer","url":"/engineer","group":"Reasoning Origins"},"next":{"title":"Combat","url":"/combat","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}