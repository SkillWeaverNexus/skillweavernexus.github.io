{"kind":"Article","sha256":"32ba248e3bc359ce3f0b11162d95fb1f8b8115971eeeccb0f1155b69900793dc","slug":"monstrous","location":"/origins/physicality/monstrous.md","dependencies":[],"frontmatter":{"title":"Monstrous","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"thumbnail":"/build/monstrous-copy-2492f3da7052cd1a6a95148c98b1e8c3.png","exports":[{"format":"md","filename":"monstrous.md","url":"/build/monstrous-31f4c767d731c538a7842123267c1a1f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/monstrous-copy-2492f3da7052cd1a6a95148c98b1e8c3.png","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TO5gTrHFt9","urlSource":"../../img/origins/monstrous-copy.png"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"You have a lineage leading to (or some sort of event-triggered) monstrous capabilities. Choose one of the following (or work with your GM to make a new one):","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sbCpcZjmq9"}],"key":"ycDb3kMctF"},{"type":"details","open":true,"children":[{"type":"summary","children":[{"type":"text","value":"Vampiric","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"nf07FPs1HL"}],"key":"NDVU5dfCbj"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"You have some level of vampirism. You gain a bite (melee) attack which costs 2 stamina, uses your personality die [13], and deals damage equal to your player level and inflicts the bleeding condition using a d4. You gain the spell Suggest for free, so long as you have the Magic Initiate ability. Your GM may impose sunlight related debuffs.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"zru9hEgDsO"}],"key":"SiP7CKUIkq"}],"key":"xWL2XLd3QH"}