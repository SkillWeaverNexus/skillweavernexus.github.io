ne":21,"column":1}},"key":"FXk7p6lKhE"},{"type":"inlineCode","value":"30 HP","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"B6V10Hql1V"},{"type":"text","value":" would restore ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Qftr8NHpWX"},{"type":"inlineCode","value":"15 HP","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"BClfmIn9tj"},{"type":"text","value":", leaving them at ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"VfNejmyFHS"},{"type":"inlineCode","value":"45/50 HP","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"kdnb6MwUh4"},{"type":"text","value":". So expending, e.g., a healing potion that restores ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"lTotW4GNVm"},{"type":"inlineCode","value":"10 HP","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"UdayCIaYNs"},{"type":"text","value":" would actually be worth a net ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"F9SyDEaXuZ"},{"type":"inlineCode","value":"13 HP","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"fzjetooXtX"},{"type":"text","value":" across the rest.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"kX57kGOCW7"}],"key":"EO1gaHqpVs"}],"key":"bkGYgvOVvP"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Downtime","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"a166Yaf4yH"}],"identifier":"downtime","label":"Downtime","html_id":"downtime","implicit":true,"key":"Rothk4N0MO"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Downtime is a critical part of adventuring in SWN. Numerous activities can take place during downtime, including learning new spells, building or modifying equipment and armor, research projects with materials obtained during adventures, and more.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"hByMfq1VIr"}],"key":"o4gvTYMS0j"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Throughout this book, you’ll find examples of activities or tasks that reference that they take place during downtime. We allow GMs latitude in defining just how long your party must ``chill out’’ and rest to constitute downtime; we suggest at minimum that 8-12 hours are required for a short downtime, while full days are especially conducive to making downtime progress. Note that Downtime contributes toward Rest and Recovery (next section).","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"b0r4cZjfOg"}],"key":"vSjifgD2iE"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Projects","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"e9oeYHYm1a"}],"identifier":"projects","label":"Projects","html_id":"projects","implicit":true,"key":"LfIn6MW8t0"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Most things that happen during downtime are characterized as Projects. Projects have a specific DL to achieve them that is generally much higher than for a single action. When you make a project roll during downtime, it represents your extended effort, and you keep track of a total tally. Once you reach that final DL, your project is complete.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"KMocDCnIMs"}],"key":"wvIGfsKBVp"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Depending on the length of a given downtime, you may be able to make a more than one project roll, which you can either split between multiple projects or apply toward the same one. As a general guideline, a full day’s work (12 hours) is the amount of time covered by 1 project roll. Some abilities and origins indicate you can carry out certain projects more efficiently. For example, an Engineer (origin ability) can build certain devices in half the normal time --- this means that they can make 2 checks per day toward their tinkering project, rather than one. It is possible of course to ``stay up all night working,‘’ but rolls made after a point will incur disadvantage from lack of sleep.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"LM5YnYS8si"}],"key":"BGCpxGRlXX"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"The primary axes for projects are","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"khk4hDlQKe"}],"key":"KzDxUznqJx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":39,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Time: related to the total DL, defines how many checks will likely be needed to complete the project.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"sUMKSjEAdx"}],"key":"lsmttl412f"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Materials: might need to be gathered or sought out. As described in Chapter N, materials generally have rarity tags which indicate whether they are readily available during downtime, or whether they must be obtained more specifically, e.g., while adventuring, or outside of downtime.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"X7160f36v7"}],"key":"X5XnMPXfqj"}],"key":"rx0rTNg3J5"}],"key":"jW7qUJX9Qb"}],"key":"SK7q6OyzDF"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Health and Death","url":"/health","group":"Core Mechanics"},"next":{"title":"Status Conditions","url":"/status-conditions","group":"Core Mechanics"}}},"domain":"http://localhost:3000"}