{"kind":"Article","sha256":"42f930678558b1ed746bf26d88c140659444ffe2a9ca9e3e70553b9218435c0c","slug":"surprise","location":"/combat/surprise.md","dependencies":[],"frontmatter":{"title":"Surprise","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"exports":[{"format":"md","filename":"surprise.md","url":"/build/surprise-e33a40e19835d7310ce8b411aa7442cc.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"In the case of ambushes or surprising situations, the GM can determine that there is sufficient cause to grant one party the benefit of surprise. In this case, the following occurs:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"uQeuin5Hj3"}],"key":"YLVpEFrnGk"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Initiative is rolled as normal and noted.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"mwfSBgOZMo"}],"key":"k3ZRiCgOdp"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"One member of the surprising party can take their turn immediately (first initiative)","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"FO7Inad5ZT"}],"key":"FjZAFLn1xV"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"During the environmental turn, all other surprising party members can use their reactions, if desired, to trigger effects, attack, or otherwise enact the surprising action.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"YZkz5vl2qR"}],"key":"NsMm4gQlQb"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"After this environmental turn, the side with the second entry in the initiative order takes their turn, followed by the third, and so on. This can be the surprised, surprising, or another party. This round proceeds as normal, except that the surprised party cannot use reactions.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"apICqGJzka"}],"key":"K7GpmwUxS6"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"At the top of the round, initiative fully invokes, and the side with the highest initiative proceeds before the environmental round. Combat from here proceeds as normal.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"UGJZNHPcQj"}],"key":"PvH6ha9o8Q"}],"key":"WVaEoKLLRn"}],"key":"W2GpiGTpfq"}],"key":"SdYBElxXoH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Initiative","url":"/initiative","group":"Reasoning Origins"},"next":{"title":"Combat Awareness and Cover","url":"/awareness","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}