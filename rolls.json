{"kind":"Article","sha256":"5104ea9b5419707d1ca75524d9bbbd794edd079a3b328ff9c9ef20ea99e9a570","slug":"rolls","location":"/rolls.md","dependencies":[],"frontmatter":{"title":"Actions and Dice Rolls","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"exports":[{"format":"md","filename":"rolls.md","url":"/build/rolls-0a469192c781aa10723c5863cbdb53c5.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Characters drive the action in SWN, and when your character wishes to do something in the world, the GM will ask them to make an ability check to try to carry it out. This roll will likely be for a specific available subskill --- like Perception/Sound, to hear a distant animal cry. In some cases, a base ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ddHPlJhcYU"},{"type":"crossReference","label":"Perception","identifier":"term-perception","kind":"definitionTerm","children":[{"type":"text","value":"Perception","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"t83G1vpStP"}],"template":"{name}","enumerator":"undefined","resolved":true,"html_id":"term-perception","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"Nhq7Nqehjn"},{"type":"text","value":" roll may be asked for.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"uSZe2vG2gh"}],"key":"vVa5aG1ASc"},{"type":"heading","depth":2,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Rolling Mechanics","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"mn265woeR4"}],"identifier":"rolling-mechanics","label":"Rolling Mechanics","html_id":"rolling-mechanics","implicit":true,"key":"oi4tBQzhAR"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The rolling mechanic in SWN is a bit unique: You roll a certain number of die of the type associated with a given skill, and then sum the highest two, or lowest two (depending on if you have disadvantage or advantage):","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"a9Gwpa2nzj"}],"key":"l3RQtKK1JY"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"For a standard roll, roll 3DN and keep the highest two.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"LwiTfArI2a"}],"key":"U8zmVJbdVQ"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For a minor advantage roll, roll 4DN and keep the highest two.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ZUbu1n9v3j"}],"key":"dsqVPYLI0i"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"For a major advantaged roll, roll 5DN and keep the highest two.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"rRwR4T76eg"}],"key":"YuBo9N9NdF"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"For a minor disadvantaged roll, roll 4DN and keep the lowest 2.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"gPW3pR0RLm"}],"key":"Rhf9BTSozx"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"For a major disadvantaged roll, roll 5DN and keep the lowest 2.","position":{"s