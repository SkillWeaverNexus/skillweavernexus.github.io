":1},"end":{"line":15,"column":1}},"key":"lkbJHfHDgE"}],"key":"a1o8t3FbbG"},{"type":"text","value":" is to use your die for the associated core skill. In practice, however, each player will have a unique set of abilities that provide bonuses only to certain circumstances (e.g., a bonus to Perception/Sound but not Perception/Sight). Your character sheet, or ability cards, will help you track your set of bonuses you may have across the sub disciplines, making it easy to know what to add to your roll when the situation calls for it.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"vGo9mXP1R6"}],"key":"MqSTFGHdgy"},{"type":"admonition","class":"note ","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"qWLOM0emE1"}],"key":"hHtNUgFH4D"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Let’s say you have an ability that grants +1 on stealth/sight checks made in dim light or darkness, and a ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"hkgLizMptF"},{"type":"inlineCode","value":"d8","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"gizevauZvg"},{"type":"text","value":" in your Stealth skill. Making such a roll in a dark alleyway, you would roll ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"vQ1VN9Pgxz"},{"type":"inlineCode","value":"3d8","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"tAkTD9dwD3"},{"type":"text","value":", keeping and summing the higher two dice (e.g., if you rolled [","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"oSXRmG6scp"},{"type":"inlineCode","value":"1,4,5","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"WQuKAAKthl"},{"type":"text","value":"], you would keep and sum ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"H35GdNeB1A"},{"type":"inlineCode","value":"4+5=9","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"oFSvgxrw4f"},{"type":"text","value":"). Then you would add your +1 bonus for a total roll of 10.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"U6yUQwMu3Y"}],"key":"FCqNCb9UGL"}],"key":"NgbvpkqqbD"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Advantage and Disadvantage","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"gmYvDEaglJ"}],"identifier":"advantage-and-disadvantage","label":"Advantage and Disadvantage","html_id":"advantage-and-disadvantage","implicit":true,"key":"DZErbnZ0qf"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"As described in the rolling examples above, SWN defines two forms of advantage and disadvantage: major and minor.\nMinor advantage and disadvantage are circumstantial bonuses reflecting small but meaningful improvements in your ability to complete a task.\nThe Help action is an example of minor advantage, and many ablities grant it as well. Minor disadvantage is a similarly moderate disadvantage.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"CvsUw9txue"}],"key":"IUwvJ7UGbx"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Major advantage and disadvantage are more serious, and tend to be rarer circumstances or related to your areas of greatest expertise, or dealing with major issues.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"iMtUkltMyy"}],"key":"obTZbaQdS8"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"When multiple forms of advantage and disadvantage apply to the same roll:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"TV6cJRcPIN"}],"key":"Uu2nOjbW4p"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":30,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"minor advantage and minor disadvantage cancel out","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"RyV9kZEpwR"}],"key":"Dj0MmMhZ0p"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"major advantage and minor disadvantage cancel out","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"hRqIpGIaSO"}],"key":"WNfILQPaZX"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"major advantage and minor disadvantage result in minor advantage","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"J0uQyfvGdT"}],"key":"WKImhUeDZG"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"major disadvantage and minor advantage result in minor disadvantage","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BY86Gt3D14"}],"key":"nDfzR5feW8"}],"key":"tmr0FgYR9G"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Exploding Rolls","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"YnAzdNabvQ"}],"identifier":"exploding-rolls","label":"Exploding Rolls","html_id":"exploding-rolls","implicit":true,"key":"srz2gr9RQi"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"When you roll the highest value on a die among your kept dice, it explodes! You reroll that dice, adding the new roll to your total, until it does not land on the maximum value. In principle, both of your kept dice could explode, and you would follow this procedure for both.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"xCdOhTqeHs"}],"key":"ciOzYdFjXr"},{"type":"heading","depth":2,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Fate Rolls","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"hBWFEzA66O"}],"identifier":"fate-rolls","label":"Fate Rolls","html_id":"fate-rolls","implicit":true,"key":"lYKqB5VDw1"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"yp1RK3n0xr"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Fate Roll","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"KFIUAsU12B"}],"key":"pIzVQ3uWht"},{"type":"text","value":" is a special kind of roll made with a ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"kDN2PxwqUq"},{"type":"inlineCode","value":"d20","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"wULtkhpj9Z"},{"type":"text","value":", generally with no modifiers. It encompasses scenarios in which true luck or fate plays a major roll in a particular outcome. A GM can ask for a fate roll for thematic or roleplay reasons, to let chance decide a particular outcome, and certain scenarios in the game specifically require a fate roll.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Y2mxtpDjT8"}],"key":"in9lcYKaoy"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Defined Fate Rolls have a table of defined outcomes for rolls of ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"tk7gzBxKPZ"},{"type":"inlineCode","value":"natural 1","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"yuPmt2hYRh"},{"type":"text","value":", ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"VnoENv7ZL7"},{"type":"inlineCode","value":"2-9","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"zxiRwGHFkZ"},{"type":"text","value":", ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"OJ5zQZuJgF"},{"type":"inlineCode","value":"10-19","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"jo5Jcsah77"},{"type":"text","value":", and ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"B8sJDVAENG"},{"type":"inlineCode","value":"natural 20","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"rjR33mAPFk"},{"type":"text","value":", and thematic fate rolls can usually be decided on similar lines. Mechanics that require a fate roll will indicate the possible outcomes in this way; for example, the ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"YMlVdUpo1i"},{"type":"link","url":"augur","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Augur Origin","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"wKqkYnPCVd"}],"urlSource":"augur","key":"aRr38rrR1i"},{"type":"text","value":" has a Vision Invocation ability that calls for a fate roll, and provides interpretations for the roll groups above.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"eZIkkgs05G"}],"key":"ZCSKDoECTy"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The most common time a Fate Roll is invoked is if you roll ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"f6y0qIkzdF"},{"type":"strong","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"snake eyes","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"SV73yXJVDM"}],"key":"SmxXKBqXZJ"},{"type":"text","value":" (2 ones) on ANY of the dice in an ability roll (including ones you normally remove), you feel the swirling strands of fate tighten around you, and time stills in a moment of unrealized potential. When this happens, you make a ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Mp7YaETqTT"},{"type":"strong","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Fate Roll","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"iTcyupS3gS"}],"key":"UdFHuLbJVu"},{"type":"text","value":". The table below lays out how to resolve the outcome of this roll.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"OyjVRJUihE"}],"key":"hweHisOER7"},{"type":"table","position":{"start":{"line":48,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Fate Roll","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"UesxUeBMWm"}],"key":"yDTEFqBBr5"},{"type":"tableCell","header":true,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Outcome","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"NHAJSbVB5c"}],"key":"qGE5hj3qeM"}],"key":"sqm8bxMgA6"},{"type":"tableRow","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"10-19","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"cICx0OlwIk"}],"key":"Jw2be8Xu6o"},{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"The tension fizzles, and your ability check resolves as normal.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"Er82tbYYc8"}],"key":"SxJP6zXWR2"}],"key":"m1iWGrLijh"},{"type":"tableRow","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"2-9","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"ljRVQ0qgc1"}],"key":"bViT6DfcdR"},{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Fate drifts away from you. If your ability check was a success, your GM will describe or ask you to describe an unintended negative consequence or outcome that accompanies it. If your check was a failure, an additional, meaningful consequence or outcome is triggered.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"RYIHTS3DwU"}],"key":"EN3sBFlWr5"}],"key":"IWGu52avdu"},{"type":"tableRow","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Natural 1","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"t3rFpUrQdY"}],"key":"apIaZOX6PS"},{"type":"tableCell","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"On a natural 1, fate abandons you. Regardless of the outcome of your original roll, you fail your check and a major consequence emerges.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"YoYKsNO4xy"}],"key":"YUTC3sqZJa"}],"key":"FJuP8q5hiN"},{"type":"tableRow","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Natural 20","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"nas70iXV0U"}],"key":"VbrRnlx3xg"},{"type":"tableCell","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Fate bestows you a boon. If your original roll would have failed the DL for the attempted check, it instead succeeds. And if your roll was already a success, a major positive consequence or outcome accompanies it, which your GM will describe or ask you to describe.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"Jk5DghiE1N"}],"key":"E0PlLVQsTv"}],"key":"bd3hYrEvSG"}],"key":"p220W0xwdN"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Fate rolls grow more common the more dice are rolled (both in cases of advantage and disadvantage); Fate does not like odds being twisted, even when it is for good reason. On the other hand, as your level up your dice toward ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"HXuTb9HgtH"},{"type":"inlineCode","value":"d12","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"LxVSPJeZzN"},{"type":"text","value":"s, and hone expertise in your abilities, the chances of snake eyes decreases. Once fate steps in, however, it is out of your hands... almost. Several abilities in the game, scattered throughout the skill trees, grant circumstantial abilities to intervene in fateful moments, either for yourself or for your companions, to nudge a fated roll towards a positive outcome.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"bxbcp2IDXp"}],"key":"LvMOhGQdDQ"},{"type":"heading","depth":2,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Difficulty Level","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"QS9VBtzwdn"}],"identifier":"difficulty-level","label":"Difficulty Level","html_id":"difficulty-level","implicit":true,"key":"Fk4CsyApoI"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Every action proposed by a player that is nontrivial has an associated Difficulty Level (DL), which encompasses how difficult it is to achieve.\nBy rolling dice in addition to a base stat, the final roll is compared to the DL. In general, exceeding the DL by 5 is worth an additional benefit, and missing the DL by 10 is worth an additional drawback, though this is left to the GM’s discretion.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"IvWVvVj1BZ"}],"key":"e5S5TrxXrg"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The following Difficulty scale is a rough guideline for the DL of a task:","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"mIm1Ko2KEF"}],"key":"PGInB3kC3c"},{"type":"table","position":{"start":{"line":63,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"tableRow","po