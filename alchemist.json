 a simple Alchemy check.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"TBhnDJb1c4"}],"key":"B4gxPsV7Xn"}],"key":"jNRoLcXA2U"},{"type":"details","open":true,"children":[{"type":"summary","children":[{"type":"text","value":"Efficient Formulation","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"l877oRYkin"}],"key":"pG3ttBAz5B"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"When crafting any alchemical item (potion, poison, bomb, etc.) during downtime, you require half the typical ingredient cost, and lower the project DL by 20.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"qNrV5FrzJj"}],"key":"u2I6ru9ViU"}],"key":"REA80KBZ4V"},{"type":"details","open":true,"children":[{"type":"summary","children":[{"type":"text","value":"Alchemic Prowess","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"HrzpeqtlLq"}],"key":"bLSGmdZfuB"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"You start with a specialized kit of glassware, implements, and basic reagents, and are proficient in its use. This kit serves as a portable laboratory, allowing you to attempt certain simple alchemical preparations even without access to a full lab. With this kit, you can Identify common poisons or potions, create one simple alchemical item with 10 uninterrupted minutes, and stabilize volatile alchemical compounds that might otherwise deteriorate with a successful ability check.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Erw3lZmGuh"}],"key":"YrTbcO33Ko"}],"key":"oikOtJ2yok"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","va