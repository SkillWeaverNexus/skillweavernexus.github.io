{"kind":"Article","sha256":"2d7b30976fb1ad2964ccf60df59decf37a1ba48189c2d46919c79828d24b346c","slug":"arcanist","location":"/origins/reasoning/arcanist.md","dependencies":[],"frontmatter":{"title":"Arcanist","github":"https://github.com/SkillWeaverNexus/skillweavernexus.github.io","keywords":[],"thumbnail":"/build/arcanist-7398039b7f18926b68b2763c8a74992a.png","exports":[{"format":"md","filename":"arcanist.md","url":"/build/arcanist-26c4b0fa8ec87493884bbe0a4f03fdbd.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/arcanist-7398039b7f18926b68b2763c8a74992a.png","alt":"augur","align":"center","key":"Fgw9cCJBth","urlSource":"../../img/origins/arcanist.png"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"You have a special affinity for the subtle nature of spell weaving, allowing you to modulate existing spells to make them your own. Your Arcanic Die, if you cast spells, is Arcana. For the cost of +1 increased toxicity to cast, you can change the damage type of any spell you know to a different type when casting. For +2 toxicity to cast, you can empower spells to deal damage using one die higher than normal. When developing new spells or combining fragments during downtime, you have major advantage on your Project Rolls.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pxjJ0rnUQc"}],"key":"dc7vSbsfWV"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"emphasis","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Backstory Hook","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uiKjC2rdxK"}],"key":"Bn1hSdz7rJ"}],"key":"CI7bdZaMRO"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"What led to your preternatural skills with magical casting? Did you have an experienced mentor? Access to a fantastic library? A close connection with a supernatural entity or god? Simply a prodigy?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"U2aX3fDI9h"}],"key":"YhGiZAjzuQ"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Has this skill developed recently or have you had it a long time, and if so, has it been widely known or a secret? If a secret, why?","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"MQrTo5MOSX"}],"key":"sDwAoiAww7"}],"key":"UE7WH4TBhM"}],"key":"rd8IhFP8WG"}],"key":"sfvAgh2fhN"}],"key":"N3hDpd4Eyl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tradesmith","url":"/tradesmith","group":"Physicality Origins"},"next":{"title":"Augur","url":"/augur","group":"Reasoning Origins"}}},"domain":"http://localhost:3000"}